+++ b/src/pairing_impl.hpp
@@ -714,6 +714,11 @@ MCL_CXX_API void cyclotomicSqr(Fp12& y, const Fp12& x)
 	fasterSqr(y, x);
 }
 
+MCL_CXX_API void mulSparseLine(Fp12& z, const Fp6& x)
+{
+	mulSparse(z, x);
+}
+
 MCL_CXX_API void millerLoop(Fp12& f, const G1& P_, const G2& Q_)
