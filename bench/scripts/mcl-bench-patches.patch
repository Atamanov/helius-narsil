 // x must lie in the cyclotomic subgroup, the Fp4 shortcut is wrong otherwise
 MCL_CXX_API void cyclotomicSqr(Fp12& y, const Fp12& x);
+// x is one D-twist Miller line, Fp6 (a,b,c) = mul_by_034 (c4,c0,c3)
+MCL_CXX_API void mulSparseLine(Fp12& z, const Fp6& x);
 MCL_CXX_API void millerLoop(Fp12& f, const G1& P_, const G2& Q_);
 MCL_CXX_API void pairing(Fp12& f, const G1& P, const G2& Q);
 
diff --git a/src/pairing_impl.hpp b/src/pairing_impl.hpp
index b3a292d3..f9eaf0d1 100644
