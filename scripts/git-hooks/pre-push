#!/bin/sh
# Reject local-only branches, then run a fast smoke test.
#
# The branch guard is the one check CI cannot make, because by the time CI
# sees a ref it has already left the machine. The rest of the publish gates
# live in CI, which runs them across both toolchains and all feature sets.
set -eu
while read -r local_ref _ _ _; do
    case "$local_ref" in
        refs/heads/local/*)
            echo "pre-push: $local_ref is a local-only branch, refusing to push" >&2
            exit 1
            ;;
    esac
done

# Both steps use the release profile so they share one build cache. The
# property tests adapted from arkworks are unusable unoptimized.
cargo fmt --check
cargo clippy --release --features std --lib --tests -- -D warnings
cargo test --release --features std --lib
